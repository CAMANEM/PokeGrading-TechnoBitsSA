## ============================================================
## PokéGrading — .gitignore
## Cubre: Dart, Flutter, Docker, IDEs, Windows, macOS, Linux
## ============================================================

# ─── Secretos y configuración local ──────────────────────────
.env
*.env.local
*.env.production
*.env.staging
*.key
*.pem
*.p12
*.pfx

# ─── Dart ─────────────────────────────────────────────────────
# Archivos generados por pub
.dart_tool/
.packages
build/
pubspec.lock

# Archivos generados por code generation
*.g.dart
*.freezed.dart
*.gr.dart

# ─── Flutter ──────────────────────────────────────────────────
# Flutter build outputs
*/build/
frontend/build/

# Flutter specific
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# Flutter Web
frontend/web/flutter_service_worker.js
frontend/web/flutter.js
frontend/web/flutter_bootstrap.js

# ─── IDEs ─────────────────────────────────────────────────────
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# IntelliJ / Android Studio
.idea/
*.iml
*.iws

# Local History for VS Code
.history/

# ─── Docker ───────────────────────────────────────────────────
# Datos persistentes de volúmenes (si se montan localmente)
docker/data/
postgres_data/
pgadmin_data/

# ─── Sistema Operativo ────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Icon?

# Windows
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ─── Logs ─────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ─── Temporales ───────────────────────────────────────────────
*.tmp
*.temp
*.swp
*.swo

# ─── Cobertura de pruebas ────────────────────────────────────
coverage/
lcov.info
*.coverage
