# ============================================================
# PokéGrading — Variables de Entorno
# Copia este archivo como .env y ajusta los valores
# ============================================================

# --- Entorno ---
APP_ENV=development
APP_VERSION=0.1.0

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_LOG_LEVEL=debug

# --- Logging ---
LOG_DIR=./logs
LOG_FILE_ENABLED=true
LOG_FORMAT=json
LOG_RETENTION_DAYS=30

# Azure Application Insights (optional)
APPINSIGHTS_ENABLED=false
APPINSIGHTS_CONNECTION_STRING=

# --- Frontend ---
FRONTEND_PORT=3000
FLUTTER_API_BASE_URL=http://localhost:8080

# --- Base de Datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pokegrading
DB_USER=pokegrading_user
DB_PASSWORD=pokegrading_secret
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=30

# --- MongoDB (image storage via GridFS) ---
MONGO_URI=mongodb://localhost:27017/pokegrading_images
MONGO_DB_NAME=pokegrading_images
MONGO_PORT=27017

# --- Seguridad ---
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_EXPIRY_HOURS=24
BCRYPT_ROUNDS=12

# --- B2B API ---
B2B_RATE_LIMIT_CARDS_PER_MONTH=10000
B2B_IDEMPOTENCY_TTL_SECONDS=86400
B2B_MAX_CARDS_PER_REQUEST=100
B2B_API_KEY_PEPPER=
B2B_DEV_API_KEY=pk_test_b2b_dev_key

# --- Email SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@pokegrading.com
SMTP_FROM_NAME=PokéGrading
SMTP_USE_SSL=false

# --- Ejemplos rápidos (elige uno y completa los valores) ---
# 1) Gmail / Google Workspace (usar App Password si tienes 2FA)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-account@gmail.com
# SMTP_PASSWORD=your_app_password_here
# SMTP_FROM_EMAIL=your-account@gmail.com
# SMTP_FROM_NAME=PokéGrading
# SMTP_USE_SSL=false

# 2) Outlook / Hotmail / Office365 (STARTTLS en 587)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=your-account@outlook.com
# SMTP_PASSWORD=your_app_password_or_account_password
# SMTP_FROM_EMAIL=your-account@outlook.com
# SMTP_FROM_NAME=PokéGrading
# SMTP_USE_SSL=false

# 3) Resend (API-based; más simple para desarrollo)
# Usa un sender válido. Para pruebas rápidas, Resend documenta onboarding@resend.dev.
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_FROM_NAME=PokéGrading

# --- pgAdmin (solo desarrollo) ---
PGADMIN_EMAIL=admin@pokegrading.local
PGADMIN_PASSWORD=admin

# --- Umbrales de Búsqueda ---
# Confianza mínima para auto-aceptar un candidato (0-100)
SEARCH_ACCEPTED_CONFIDENCE=90.0

# --- Image Quality Service (IQS) ---
# Umbral mínimo de calidad de imagen (0-100)
IQS_ACCEPTED_THRESHOLD=50
# Varianza Laplaciana para nitidez perfecta
IQS_SHARPNESS_PERFECT_VARIANCE=150.0
# Rango de brillo aceptable (luminancia ITU-R BT.709)
IQS_BRIGHTNESS_MIN=80.0
IQS_BRIGHTNESS_MAX=180.0

# --- Enhanced IQS ---
ENH_TENENGRAD_PERFECT_MAGNITUDE=500.0
ENH_ENTROPY_PERFECT_VALUE=7.0
ENH_ENTROPY_MIN_VALUE=3.0
ENH_CONTRAST_IDEAL_LOWER=0.2
ENH_CONTRAST_IDEAL_UPPER=0.6
ENH_CONTRAST_LOW_THRESHOLD=0.1
ENH_CONTRAST_HIGH_THRESHOLD=0.8
ENH_LAPLACIAN_SHARPNESS_WEIGHT=0.6
ENH_TENENGRAD_SHARPNESS_WEIGHT=0.4
ENH_SHARPNESS_OVERALL_WEIGHT=0.35
ENH_BRIGHTNESS_OVERALL_WEIGHT=0.25
ENH_ENTROPY_OVERALL_WEIGHT=0.20
ENH_CONTRAST_OVERALL_WEIGHT=0.20

# --- Pesos de Grading (BGS standard: 40/20/20/20) ---
GRADING_CENTERING_WEIGHT=0.40
GRADING_CORNERS_WEIGHT=0.20
GRADING_EDGES_WEIGHT=0.20
GRADING_SURFACE_WEIGHT=0.20
GRADING_HIGH_CONFIDENCE_STD_DEV=0.5
GRADING_LOW_CONFIDENCE_STD_DEV=2.0

# --- Evaluación / Revisión Humana ---
EVAL_REVIEW_CONFIDENCE_THRESHOLD=0.7
EVAL_REVIEW_GAP_THRESHOLD=2.0

# --- Límites de Validación ---
VALIDATION_MAX_SET_LENGTH=60
VALIDATION_MAX_EDITION_LENGTH=40
VALIDATION_MAX_LANGUAGE_LENGTH=30
VALIDATION_MAX_FINISH_LENGTH=30
VALIDATION_MAX_AUTHOR_LENGTH=100
VALIDATION_MIN_IMAGE_BASE64_BYTES=5120
VALIDATION_HP_MIN=0
VALIDATION_HP_MAX=2000
VALIDATION_YEAR_MIN=1950
